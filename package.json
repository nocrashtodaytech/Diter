{
  "name": "diter",
  "productName": "Diter",
  "version": "2.0.4",
  "description": "Diter · 跨平台 USB 启动盘写入工具（Windows / macOS / Linux）",
  "main": "electron/main.js",
  "author": "Diter",
  "license": "MIT",
  "private": true,
  "scripts": {
    "build": "node build/bundle.mjs",
    "preview": "node build/bundle.mjs --preview",
    "start": "node build/bundle.mjs && electron .",
    "dev": "node build/bundle.mjs --watch",
    "package": "bash build/package.sh",
    "dist:mac": "node build/bundle.mjs && electron-builder --mac",
    "dist:win": "node build/bundle.mjs && electron-builder --win",
    "dist:linux": "node build/bundle.mjs && electron-builder --linux"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "esbuild": "^0.24.0",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "dev.diter.usb",
    "productName": "Diter",
    "directories": { "output": "release", "buildResources": "assets" },
    "files": ["electron/**/*", "dist/**/*", "package.json"],
    "asarUnpack": ["electron/core/**/*"],
    "mac": {
      "category": "public.app-category.utilities",
      "target": [{ "target": "dmg", "arch": ["x64", "arm64"] }],
      "minimumSystemVersion": "10.13",
      "hardenedRuntime": false,
      "entitlements": "assets/entitlements.mac.plist",
      "extendInfo": { "NSRemovableVolumesUsageDescription": "Diter 需要访问可移动磁盘以写入启动盘。" }
    },
    "win": {
      "target": [{ "target": "nsis", "arch": ["x64"] }],
      "icon": "assets/icon.ico",
      "requestedExecutionLevel": "asInvoker"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Diter",
      "installerIcon": "assets/icon.ico",
      "uninstallerIcon": "assets/icon.ico",
      "installerHeaderIcon": "assets/icon.ico",
      "artifactName": "Diter-${version}-win-x64-setup.${ext}"
    },
    "linux": {
      "target": ["AppImage", "deb"],
      "category": "Utility",
      "icon": "assets/icon.png",
      "maintainer": "nocrashtodaytech <nocrashtodaytech@users.noreply.github.com>",
      "synopsis": "Cross-platform bootable USB drive creator",
      "description": "Diter creates bootable USB drives from Windows, Linux and macOS install images, with a strong safety layer that locks your system disk.",
      "artifactName": "Diter-${version}-${arch}.${ext}"
    },
    "deb": {
      "depends": ["policykit-1"],
      "recommends": ["gdisk"]
    }
  }
}
