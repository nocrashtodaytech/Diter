{
  "name": "diter",
  "productName": "Diter",
  "version": "2.0.2",
  "description": "Diter · 跨平台 USB 启动盘写入工具（Windows / macOS / Linux）",
  "main": "electron/main.js",
  "author": "Diter",
  "license": "MIT",
  "private": true,
  "scripts": {
    "build": "node build/bundle.mjs",
    "preview": "node build/bundle.mjs --preview",
    "start": "node build/bundle.mjs && electron .",
    "dev": "node build/bundle.mjs --watch",
    "package": "bash build/package.sh",
    "dist:mac": "node build/bundle.mjs && electron-builder --mac",
    "dist:win": "node build/bundle.mjs && electron-builder --win",
    "dist:win:appx": "node build/bundle.mjs && electron-builder --win appx",
    "dist:linux": "node build/bundle.mjs && electron-builder --linux"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "esbuild": "^0.24.0",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "dev.diter.usb",
    "productName": "Diter",
    "directories": { "output": "release", "buildResources": "assets" },
    "files": ["electron/**/*", "dist/**/*", "package.json"],
    "asarUnpack": ["electron/core/**/*"],
    "mac": {
      "category": "public.app-category.utilities",
      "target": [{ "target": "dmg", "arch": ["x64", "arm64"] }],
      "minimumSystemVersion": "10.13",
      "hardenedRuntime": false,
      "entitlements": "assets/entitlements.mac.plist",
      "extendInfo": { "NSRemovableVolumesUsageDescription": "Diter 需要访问可移动磁盘以写入启动盘。" }
    },
    "win": {
      "target": [
        { "target": "nsis", "arch": ["x64"] },
        { "target": "appx", "arch": ["x64"] }
      ],
      "icon": "assets/icon.ico",
      "requestedExecutionLevel": "asInvoker"
    },
    "appx": {
      "applicationId": "Diter",
      "identityName": "nocrashtodaytech.Diter",
      "publisher": "CN=nocrashtodaytech",
      "publisherDisplayName": "nocrashtodaytech",
      "displayName": "Diter",
      "backgroundColor": "#1e232e",
      "showNameOnTiles": true,
      "languages": ["zh-CN", "zh-TW", "en-US", "ko", "ru", "ar"]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Diter",
      "installerIcon": "assets/icon.ico",
      "uninstallerIcon": "assets/icon.ico",
      "installerHeaderIcon": "assets/icon.ico",
      "artifactName": "Diter-${version}-win-x64-setup.${ext}"
    },
    "linux": {
      "target": ["AppImage", "deb"],
      "category": "Utility"
    }
  }
}
